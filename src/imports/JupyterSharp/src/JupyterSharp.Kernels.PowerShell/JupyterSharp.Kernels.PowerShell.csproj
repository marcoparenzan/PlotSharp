<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>JupyterSharp.Kernels.PowerShell</PackageId>
    <Version>0.3.0</Version>
    <Authors>Marco Parenzan</Authors>
    <Description>JupyterSharp kernel that runs PowerShell cells on a single embedded Runspace (Microsoft.PowerShell.SDK), with session state shared across cells.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JupyterSharp.Kernels.Abstractions\JupyterSharp.Kernels.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.6" />
  </ItemGroup>

</Project>
