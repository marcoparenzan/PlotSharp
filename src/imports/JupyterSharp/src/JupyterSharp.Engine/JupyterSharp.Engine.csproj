    <ProjectReference Include="..\JupyterSharp.Kernels.FSharp\JupyterSharp.Kernels.FSharp.csproj" />
    <ProjectReference Include="..\JupyterSharp.Kernels.PowerShell\JupyterSharp.Kernels.PowerShell.csproj" />
    <ProjectReference Include="..\JupyterSharp.Kernels.PowerFx\JupyterSharp.Kernels.PowerFx.csproj" />
  </ItemGroup>

</Project>
