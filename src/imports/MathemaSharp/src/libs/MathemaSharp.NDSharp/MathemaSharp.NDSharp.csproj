<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Ponte fra NDSharp (ndarray con semantica NumPy) e le librerie Numbers: T[], T[,] e Complex&lt;double&gt;[] per ogni formato IEEE di Generic Math.</Description>
    <!-- NDSharp.dll accanto al ponte in artifacts/bin: serve ai #r dei notebook. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NDSharp" />
  </ItemGroup>
</Project>
